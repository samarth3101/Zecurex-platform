# =============================================================================
# ZECURE PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# -----------------------------------------------------------------------------
# For production deployment on Render/Cloud:
ENVIRONMENT=production
AUTH_ENV=production

# Database URL (PostgreSQL with asyncpg driver required: postgresql+asyncpg://...)
# [SECRET] Keep private. In Render, use the Internal Database URL with postgresql+asyncpg:// prefix
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/zecure_db
TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/zecure_test

# Allowed CORS Origins (comma-separated, NO trailing slash, NO wildcards)
CORS_ORIGINS=https://zecureone.netlify.app

# Base URL for frontend application (used in transactional password-reset emails)
APP_BASE_URL=https://zecureone.netlify.app
NEXT_PUBLIC_API_BASE_URL=https://<your-render-backend-name>.onrender.com/api/v1

# -----------------------------------------------------------------------------
# 2. AI PROVIDER (Gemini 2.5 Flash for Grounded Investigations)
# -----------------------------------------------------------------------------
# [SECRET] Google Gemini API Key for autonomous fraud investigations
GEMINI_API_KEY=
AI_PROVIDER_API_KEY=

# -----------------------------------------------------------------------------
# 3. RAZORPAY API INTEGRATION (Optional - For Live Ingestion & Webhooks)
# -----------------------------------------------------------------------------
# [SECRET] Razorpay API credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 4. AUTHENTICATION & SESSION SECURITY
# -----------------------------------------------------------------------------
# [SECRET] MUST be a unique, cryptographically secure 32+ character random string in production
# Example generation: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SESSION_SECRET=

SESSION_MAX_AGE_SECONDS=604800
TRUSTED_DEVICE_DAYS=30
OTP_EXPIRE_MINUTES=10
MAX_OTP_ATTEMPTS=5

# -----------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL CONFIGURATION (Resend / Development)
# -----------------------------------------------------------------------------
# Options: "resend" (recommended for production), "development" (local console logging)
EMAIL_PROVIDER=resend
EMAIL_FROM=onboarding@resend.dev

# [SECRET] Resend API Key (re_...)
RESEND_API_KEY=

# Optional SMTP Configuration (if using SMTP instead of Resend):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
