# =============================================================================
# ZECURE PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# -----------------------------------------------------------------------------
# Set to "production" for live deployments or "development" for local execution.
ENVIRONMENT=development
AUTH_ENV=development

# Database URL (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/zecure
TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/zecure_test

# Allowed CORS Origins (comma-separated, NO wildcards with credentials in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Base URL for frontend application (used in transactional emails)
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# -----------------------------------------------------------------------------
# 2. AI PROVIDER (Gemini 2.5 Flash for Grounded Investigations)
# -----------------------------------------------------------------------------
AI_PROVIDER_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# 3. RAZORPAY API INTEGRATION (For Live Ingestion & Webhooks)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# -----------------------------------------------------------------------------
# 4. AUTHENTICATION & SESSION SECURITY
# -----------------------------------------------------------------------------
# MUST be replaced with a cryptographically secure 32+ character random string in production
AUTH_SESSION_SECRET=zecure-session-secret-key-change-in-production-32bytes
SESSION_MAX_AGE_SECONDS=604800
TRUSTED_DEVICE_DAYS=30
OTP_EXPIRE_MINUTES=10
MAX_OTP_ATTEMPTS=5

# -----------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL CONFIGURATION
# -----------------------------------------------------------------------------
# Options: "development" (logs to stdout), "smtp" (for production SMTP / Gmail)
EMAIL_PROVIDER=development
EMAIL_FROM=security@zecure.one

# Required only if EMAIL_PROVIDER=smtp:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
