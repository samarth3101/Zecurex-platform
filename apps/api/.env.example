ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/zecure
TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/zecure_test
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret
AI_PROVIDER_API_KEY=placeholder_ai_key

# Authentication & Security
AUTH_ENV=development
AUTH_SESSION_SECRET=zecure-session-secret-key-change-in-production-32bytes
SESSION_MAX_AGE_SECONDS=604800
TRUSTED_DEVICE_DAYS=30
OTP_EXPIRE_MINUTES=10
MAX_OTP_ATTEMPTS=5

# Email Provider Configuration
EMAIL_PROVIDER=development
EMAIL_FROM=security@zecure.one
APP_BASE_URL=http://localhost:3000

# Optional SMTP Provider Configuration (for future Gmail / SMTP integration)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
